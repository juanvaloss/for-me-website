# Local development only; production values come from the SAM template.
ENVIRON=dev
DEBUG=true
SECRET_KEY=change-me
# Defaults to SQLite (server/db.sqlite3) when unset.
# DATABASE_URL=postgres://forme:forme@localhost:5432/forme
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:5173
# Web OAuth client ID for "Sign in with Google" (same as VITE_GOOGLE_CLIENT_ID in
# client/.env.local); leave it unset to turn Google sign-in off.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
